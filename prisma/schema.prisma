// name String
//
//  payment Payment[]
// }

enum PaymentType {
  QRIS
  TUNAI
}


enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Payment {
  id           String      @id @default(cuid())
  
  orderId      String @unique
  order        Order @relation(fields: [orderId], references:[id])

  method       PaymentType
  amount       Int
  cashReceived Int?
  cashReturned Int?
  createdAt    DateTime    @default(now())

  status        PaymentStatus @default(PENDING)

}


model WaitingList {
  id               String   @id @default(cuid())
  customerName     String?
  numberOfCustomer Int?
  waitingNumber    Int      @default(autoincrement())
  waitingStatus    String   @default("Waiting")

  createdAt        DateTime @default(now())
}

model Testing {
  id               String   @id @default(cuid())
}
