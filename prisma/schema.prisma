// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}


model Organization {
  id Int  @id @default(autoincrement())
  username String @unique
  email String? @unique
  password String
  apiKey String?
  status OrganizationStatus @default(PENDING_VERIFICATION)

  users  User[]
  order  Order[]
  food    Food[]
  category Category[]
  verification emailVerification[]
}

model emailVerification {
  id String @id @default(cuid())

  userOrganization Organization? @relation(fields : [OrganizationId], references: [id], onDelete: Cascade)
  OrganizationId   Int?

  token String
  createdAt DateTime @default(now())
  expiredAt DateTime
  attempts  Int @default(0) 
}


enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  RESIGN
}

model User {
  id        Int      @id @default(autoincrement())
  username  String @unique
  password  String
  email     String?
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  status    UserStatus @default(ACTIVE)
  
  userOrganization Organization? @relation(fields : [OrganizationId], references: [id])
  OrganizationId   Int?
}

model DeviceOrder {
  id        Int      @id @default(autoincrement())
  deviceName String
}

model Food {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  category    String
  price       Int
  imgPath     String?
  stocks      Int?

  orderItems OrderItem[]
  OrganizationId Int
  organization Organization @relation(fields: [OrganizationId], references: [id])

  isActive    Boolean  @default(true)

  categories Category []
}


model Category {
  id Int @id @default(autoincrement())
  name String

  OrganizationId Int
  organization Organization @relation(fields: [OrganizationId], references: [id])

  isActive Boolean @default(true)

  foods Food[]
}

enum OrderStatus {
  WAITING_PAYMENT
  PAID
  PREPARED
  READY
  COMPLETED
  CANCELLED
}

model Order {
  id        String   @id @default(uuid())
  orderNumber Int         @unique @default(autoincrement())
  createdAt DateTime @default(now())
  createdBy String?
  tableNumber Int
  status    OrderStatus   @default(WAITING_PAYMENT)
  total     Int

  OrganizationId Int
  organization Organization @relation(fields: [OrganizationId], references: [id])

  sometesting String?

  items OrderItem[]
  payment Payment?
}
  

model OrderItem {
  id      String @id @default(uuid())
  orderId String 
  order   Order  @relation(fields: [orderId], references: [id])

  foodId Int
  food   Food @relation(fields: [foodId], references: [id])

  name     String
  price    Int
  quantity Int

  createdAt DateTime @default(now())
}

